# Copy to .env.local for development. Never commit .env.local — only this file
# is tracked. Anything without the NEXT_PUBLIC_ prefix is server-only and must
# never be imported into a client component.

# --- Access gate (server-only) -------------------------------------------
# The shared passcode given to invited fellows. Checked by /api/enter.
APP_PASSCODE=choose-a-shared-passcode
# HMAC key used to sign the session cookie. Generate with:
#   openssl rand -base64 32
PASSCODE_COOKIE_SECRET=generate-a-random-32-byte-secret

# --- Anthropic (server-only; used from Phase 0.3 onward) ------------------
# API key for the Claude calls made by the route handlers.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (used from Phase 0.4 onward) --------------------------------
# Project URL. Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key, select-only RLS on the reference tables. Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, bypasses RLS. Used by scripts/seed.ts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
