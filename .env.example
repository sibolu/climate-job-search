# Copy to .env.local for development. Never commit .env.local — only this file
# is tracked. Anything without the NEXT_PUBLIC_ prefix is server-only and must
# never be imported into a client component.

# --- Access gate (server-only) -------------------------------------------
# Optional operator passcode, for you and local work. Checked by /api/enter
# before any access code; its sessions are not metered against any budget.
# Leave it unset in production unless you need it. Invited people use access
# codes instead, issued with `pnpm codes:add --cap <usd>` (one per person,
# each with its own spend cap). Use a fresh value, never the passcode once
# shared with fellows as APP_PASSCODE: that variable is no longer read (D70).
OPERATOR_PASSCODE=choose-an-operator-passcode
# HMAC key used to sign the session cookie. Generate with:
#   openssl rand -base64 32
PASSCODE_COOKIE_SECRET=generate-a-random-32-byte-secret

# --- Anthropic (server-only) ----------------------------------------------
# API key for the Claude calls made by the route handlers. SERVER-ONLY: it has
# no NEXT_PUBLIC_ prefix by design, is read only by `src/lib/llm.ts` (the one
# module allowed to call the API), and must never reach the client bundle.
# Without it `pnpm smoke:llm` skips and the app's model calls fail loudly.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase --------------------------------------------------------------
# For local development, start the stack with `pnpm db:start` and copy the
# values printed by `supabase status -o env` (API_URL, PUBLISHABLE_KEY,
# SECRET_KEY) into .env.local. They are fixed local-only dev keys.
#
# Supabase stores the reference collection (climate fields, role profiles,
# example job posts), the anonymous llm_usage rows and one running dollar
# total per access code (access_codes: a derived key, a cap, a total, a
# disabled flag, a creation time). It never stores user data — no profiles,
# no transcripts, no code or identity (PRD hard constraint).

# Project URL. Public: shipped to the browser. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key. Select-only on the reference tables, insert-only on llm_usage,
# execute-only on the two access-code budget functions, and nothing else —
# enforced by RLS and grants, so it is safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Secret key — SERVER-ONLY, bypasses RLS. Used by the repo's scripts
# only — `pnpm seed`, `pnpm db:check-rls`, `pnpm smoke:llm` (which reads
# its own llm_usage row back, something the publishable key deliberately cannot do)
# and `pnpm codes:*` (the only writer of access codes).
# Never import it into app code.
SUPABASE_SECRET_KEY=your-secret-key
