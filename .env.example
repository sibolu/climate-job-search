# Copy to .env.local for development. Never commit .env.local — only this file
# is tracked. Anything without the NEXT_PUBLIC_ prefix is server-only and must
# never be imported into a client component.

# --- Access gate (server-only) -------------------------------------------
# The shared passcode given to invited fellows. Checked by /api/enter.
APP_PASSCODE=choose-a-shared-passcode
# HMAC key used to sign the session cookie. Generate with:
#   openssl rand -base64 32
PASSCODE_COOKIE_SECRET=generate-a-random-32-byte-secret

# --- Anthropic (server-only) ----------------------------------------------
# API key for the Claude calls made by the route handlers. SERVER-ONLY: it has
# no NEXT_PUBLIC_ prefix by design, is read only by `src/lib/llm.ts` (the one
# module allowed to call the API), and must never reach the client bundle.
# Without it `pnpm smoke:llm` skips and the app's model calls fail loudly.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase --------------------------------------------------------------
# For local development, start the stack with `pnpm db:start` and copy the
# values printed by `supabase status -o env` (API_URL, ANON_KEY,
# SERVICE_ROLE_KEY) into .env.local. They are fixed local-only dev keys.
#
# Supabase stores the reference collection (climate fields, role profiles,
# example job posts) and the anonymous llm_usage rows. It never stores user
# data — no profiles, no transcripts (PRD hard constraint).

# Project URL. Public: shipped to the browser. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key. Select-only on the reference tables, insert-only on llm_usage, and
# nothing else — enforced by RLS, so it is safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-ONLY, bypasses RLS. Used by `pnpm seed` and
# `pnpm db:check-rls` only; never import it into app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
